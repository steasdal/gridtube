{
  "name": "gridtube",
  "version": "2.4.1",
  "description": "Self-hosted 2x2 YouTube live stream grid SPA",
  "type": "module",
  "scripts": {
    "dev": "vite dev --port 8080",
    "build": "vite build",
    "preview": "vite preview --port 8080",
    "start": "node build",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "db:generate": "drizzle-kit generate",
    "test": "node --test"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "@prometheus-io/client": "^0.16.1",
    "drizzle-orm": "^0.45.4",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@sveltejs/adapter-node": "^6.0.4",
    "@sveltejs/kit": "^3.3.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.8",
    "typescript": "^6.0.3",
    "vite": "^8.3.8"
  }
}
